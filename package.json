{
  "name": "radioplan",
  "version": "1.5.29",
  "private": true,
  "type": "module",
  "description": "LvPlan Pro - radio site and equipment planning workstation (single-user)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:usb": "tsc --noEmit && vite build --mode usb",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "android": "npm run build && npx cap sync android && npx cap open android",
    "desktop": "tauri dev",
    "desktop:build": "tauri icon app-icon.png && tauri build"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "geotiff": "^2.1.3",
    "jsqr": "^1.4.0",
    "leaflet": "^1.9.4",
    "qrcode-generator": "^1.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@tauri-apps/cli": "^2.1.0",
    "@types/leaflet": "^1.9.14",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "topojson-client": "^3.1.0",
    "typescript": "^5.6.3",
    "us-atlas": "^3.0.1",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^2.1.8",
    "zipcodes": "^8.0.0"
  }
}
